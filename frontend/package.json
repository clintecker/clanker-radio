{
  "name": "clanker-radio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src index.html",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
