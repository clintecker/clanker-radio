[Unit]
Description=AI Radio Station - Scheduled Show Generation Timer
Documentation=https://github.com/clintecker/clanker-radio
Requires=ai-radio-generate-shows.service

[Timer]
# Every 15 minutes. The script is a no-op unless a show airs within
# RADIO_SHOW_GENERATION_LEAD_HOURS, and a no-op once the show is READY,
# so frequent runs cost nothing but give failed runs several retries.
OnBootSec=5min
OnCalendar=*:00/15
Persistent=true

[Install]
WantedBy=timers.target
